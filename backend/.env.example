# Database
# Local development (SQLite): no server required
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:5432/learning_platform"

# JWT
JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"
JWT_EXPIRY="7d"

# Gemini API (free tier via Google AI Studio; offline verification fallback is used when empty)
GEMINI_API_KEY="AIza..."

# Google OAuth (client ID from Google Cloud Console > Credentials > OAuth 2.0 Client)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Server
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
